# API base URL (no trailing slash). Local HTTPS default: https://localhost:8082
# VITE_API_URL=

# Cognito hosted-UI domain used only for Google sign-in (AUTH-003), for example auth.quizymode.com.
# Required (together with the flag below) before the "Continue with Google" button is shown.
# VITE_COGNITO_DOMAIN=
# Google sign-in is off unless this is exactly "true". Leave it unset in .env.production until the
# Cognito/Google setup in docs/infra/COGNITO_SETUP.md is complete.
VITE_GOOGLE_SIGNIN_ENABLED=false
