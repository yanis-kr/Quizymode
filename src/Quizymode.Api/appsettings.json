{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Information",
      "Microsoft.AspNetCore.Connections": "Warning",
      "Microsoft.AspNetCore.Routing": "Warning",
      "Microsoft.Extensions.Diagnostics.HealthChecks": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "PostgreSQL": "Host=localhost;Database=quizymode;Username=postgres;Password=postgres"
  },
  "Seed": {
    "Path": "data/seed-dev"
  },
  "GitHubSeedSync": {
    "ApiBaseUrl": "https://api.github.com",
    "SourceFileIndexPath": "data/seed-source/_registry/source-file-index.json",
    "CollectionsPath": "data/seed-source/collections/public",
    "Token": "",
    "UserAgent": "Quizymode-SeedSync"
  },
  "IdeaAbuseProtection": {
    "CreateDailyLimit": 5,
    "ModerationTermsPath": "data/moderation/idea-moderation-terms.json"
  },
  "DeepSeek": {
    "ApiKey": "",
    "Model": "deepseek-flash",
    "MaxQuestions": 20
  },
  "OpenAI": {
    "ApiKey": ""
  },
  "Gemini": {
    "ApiKey": ""
  },
  "StudyGuideDocuments": {
    "MaxFileBytes": 20971520,
    "MaxPages": 300,
    "MaxTextBytes": 1048576,
    "ExtractionTimeoutSeconds": 30,
    "SectionTargetBytes": 8192,
    "SectionMaxBytes": 10240,
    "RetentionDays": 30
  },
  "StudyGuideGeneration": {
    "MonthlySectionBudget": 1000,
    "FreeDailySections": 10,
    "FreeMonthlySections": 60,
    "PremiumDailySections": 50,
    "PremiumMonthlySections": 1000,
    "FreeTierDelayMinutes": 10,
    "PollIntervalSeconds": 15,
    "ClaimBatchSize": 2,
    "LeaseMinutes": 5,
    "MaxAttempts": 3,
    "MaxTokens": 8000
  },
  "Turnstile": {
    "Enabled": false,
    "SecretKey": "",
    "VerifyEndpoint": "https://challenges.cloudflare.com/turnstile/v0/siteverify"
  },
  "Authentication": {
    "Cognito": {
      "Authority": "",
      "ClientId": "",
      "Audience": "",
      "Issuer": ""
    }
  },
  "AuditLogs": {
    "ExcludedEmails": [ "test-user@quizymode.com", "janskymail@gmail.com" ]
  },
  "GrafanaCloud": {
    "Enabled": false,
    "OtlpEndpoint": "",
    "LokiEndpoint": "",
    "OtlpInstanceId": "",
    "LokiInstanceId": "",
    "ApiKey": ""
  }
}
