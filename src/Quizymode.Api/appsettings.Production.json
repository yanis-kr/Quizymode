{
  "ForwardedHeaders": {
    // Forwarded headers are trusted from any network only because the Lightsail load balancer is the sole path in
    // to the container (#753, #906; docs/infra/LIGHTSAIL.md). ForwardLimit 1 takes only the hop it appended. If a
    // CDN or a second proxy is ever put in front of the API, or the container gets another way in, narrow these
    // networks first.
    "KnownNetworks": "0.0.0.0/0,::/0",
    "ForwardLimit": 1
  },
  "HostFiltering": {
    // #933: outside Development the API answers only these hosts (port ignored); /health is exempt for the load
    // balancer probe. Keep in step with VITE_API_URL in src/Quizymode.Web/.env.production. The root AllowedHosts stays *.
    "AllowedHosts": [ "container-service-1.g3tzw2psg9dm4.us-east-1.cs.amazonlightsail.com" ]
  },
  "Cors": {
    // The web app's origins (#906). No trailing slash: CORS compares the exact Origin value.
    "AllowedOrigins": [ "https://www.quizymode.com", "https://quizymode.com" ]
  }
}
