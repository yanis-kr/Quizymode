{
  "uid": "quizymode-media",
  "title": "Quizymode Pictures (media)",
  "tags": ["quizymode", "media"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1m",
  "time": { "from": "now-24h", "to": "now" },
  "panels": [
    { "id": 1, "type": "stat", "title": "Pending pictures in review queue", "gridPos": { "h": 6, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "grafanacloud-prom" },
      "targets": [ { "refId": "A", "expr": "quizymode_media_pending" } ] },
    { "id": 2, "type": "stat", "title": "Oldest pending review (seconds)", "gridPos": { "h": 6, "w": 6, "x": 6, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "grafanacloud-prom" },
      "targets": [ { "refId": "A", "expr": "quizymode_media_oldest_pending_seconds" } ] },
    { "id": 3, "type": "stat", "title": "Retained picture bytes", "gridPos": { "h": 6, "w": 6, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "grafanacloud-prom" },
      "targets": [ { "refId": "A", "expr": "quizymode_media_retained_bytes" } ] },
    { "id": 4, "type": "stat", "title": "Delete retries pending", "gridPos": { "h": 6, "w": 6, "x": 18, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "grafanacloud-prom" },
      "targets": [ { "refId": "A", "expr": "quizymode_media_delete_retries" } ] },
    { "id": 5, "type": "timeseries", "title": "Withdrawn pictures awaiting purge (cleanup backlog)", "gridPos": { "h": 6, "w": 12, "x": 0, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "grafanacloud-prom" },
      "targets": [ { "refId": "A", "expr": "quizymode_media_cleanup_backlog" } ] },
    { "id": 6, "type": "timeseries", "title": "Cleanup runs by outcome (retry, failure, missing = takedown/processing failures)", "gridPos": { "h": 6, "w": 12, "x": 12, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "grafanacloud-prom" },
      "targets": [ { "refId": "A", "expr": "sum by (outcome) (increase(quizymode_media_cleanup_total[1h]))", "legendFormat": "{{outcome}}" } ] },
    { "id": 7, "type": "timeseries", "title": "Uploads by outcome (refusals by problem code)", "gridPos": { "h": 6, "w": 12, "x": 0, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "grafanacloud-prom" },
      "targets": [ { "refId": "A", "expr": "sum by (outcome) (increase(quizymode_media_uploads_total[1h]))", "legendFormat": "{{outcome}}" } ] },
    { "id": 8, "type": "timeseries", "title": "Deliveries by mode and outcome", "gridPos": { "h": 6, "w": 12, "x": 12, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "grafanacloud-prom" },
      "targets": [ { "refId": "A", "expr": "sum by (mode, outcome) (increase(quizymode_media_deliveries_total[1h]))", "legendFormat": "{{mode}} {{outcome}}" } ] },
    { "id": 9, "type": "timeseries", "title": "Egress: delivered picture bytes per hour", "gridPos": { "h": 6, "w": 12, "x": 0, "y": 18 },
      "datasource": { "type": "prometheus", "uid": "grafanacloud-prom" },
      "targets": [ { "refId": "A", "expr": "sum(increase(quizymode_media_delivered_bytes_total[1h]))" } ] },
    { "id": 10, "type": "timeseries", "title": "Reviews by outcome", "gridPos": { "h": 6, "w": 12, "x": 12, "y": 18 },
      "datasource": { "type": "prometheus", "uid": "grafanacloud-prom" },
      "targets": [ { "refId": "A", "expr": "sum by (outcome) (increase(quizymode_media_reviews_total[1h]))", "legendFormat": "{{outcome}}" } ] },
    { "id": 11, "type": "timeseries", "title": "Reports filed per hour", "gridPos": { "h": 6, "w": 12, "x": 0, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "grafanacloud-prom" },
      "targets": [ { "refId": "A", "expr": "sum(increase(quizymode_media_reports_total[1h]))" } ] },
    { "id": 12, "type": "timeseries", "title": "Withdrawals by outcome (ok, stale, notfound)", "gridPos": { "h": 6, "w": 12, "x": 12, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "grafanacloud-prom" },
      "targets": [ { "refId": "A", "expr": "sum by (outcome) (increase(quizymode_media_withdrawals_total[1h]))", "legendFormat": "{{outcome}}" } ] },
    { "id": 13, "type": "timeseries", "title": "AI assistance reserved cost (USD per day)", "gridPos": { "h": 6, "w": 12, "x": 0, "y": 30 },
      "datasource": { "type": "prometheus", "uid": "grafanacloud-prom" },
      "targets": [ { "refId": "A", "expr": "sum(increase(quizymode_media_advisory_reserved_usd_total[1d]))" } ] },
    { "id": 14, "type": "timeseries", "title": "AI assistance estimated cost (USD per day)", "gridPos": { "h": 6, "w": 12, "x": 12, "y": 30 },
      "datasource": { "type": "prometheus", "uid": "grafanacloud-prom" },
      "targets": [ { "refId": "A", "expr": "sum(increase(quizymode_media_advisory_estimated_usd_total[1d]))" } ] },
    { "id": 15, "type": "timeseries", "title": "AI assistance outcomes", "gridPos": { "h": 6, "w": 24, "x": 0, "y": 36 },
      "datasource": { "type": "prometheus", "uid": "grafanacloud-prom" },
      "targets": [ { "refId": "A", "expr": "sum by (outcome) (increase(quizymode_media_advisory_total[1h]))", "legendFormat": "{{outcome}}" } ] }
  ]
}
