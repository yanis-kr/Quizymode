{
  "target": "ssm",
  "ssmPrefix": "/quizymode/prod",
  "secrets": [
    { "name": "media-s3-key", "method": "aws-iam-key", "downtime": "none",
      "iamUser": "quizymode-api-media",
      "params": { "id": "Media/S3/AccessKeyId", "secret": "Media/S3/SecretAccessKey" } },
    { "name": "gemini", "method": "browser", "provider": "gemini", "downtime": "none", "params": { "secret": "Gemini/ApiKey" } },
    { "name": "groq", "method": "browser", "provider": "groq", "downtime": "none", "params": { "secret": "Groq/ApiKey" } },
    { "name": "cerebras", "method": "browser", "provider": "cerebras", "downtime": "none", "params": { "secret": "Cerebras/ApiKey" } },
    { "name": "openrouter", "method": "browser", "provider": "openrouter", "downtime": "none", "params": { "secret": "OpenRouter/ApiKey" } },
    { "name": "openai", "method": "browser", "provider": "openai", "downtime": "none", "params": { "secret": "OpenAI/ApiKey" } },
    { "name": "grafana-cloud", "method": "browser", "provider": "grafana", "downtime": "none", "params": { "secret": "GrafanaCloud/ApiKey" } },
    { "name": "github-seed-sync", "method": "browser", "provider": "github-pat", "downtime": "none", "params": { "secret": "GitHubSeedSync/Token" } },
    { "name": "supabase-db", "method": "browser", "provider": "supabase-db", "downtime": "db-blip", "params": { "secret": "ConnectionStrings/PostgreSQL" } }
  ]
}
